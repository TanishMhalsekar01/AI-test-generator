# Copy to backend/.env for local development. backend/.env is gitignored — never commit it.

# Google Gemini (server-side only; never sent to the browser)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-pro
# Tried in order when GEMINI_MODEL cannot answer (not available to the key, out of quota,
# overloaded). Leave unset for the defaults below; set to "none" to use GEMINI_MODEL only.
GEMINI_FALLBACK_MODELS=gemini-3.6-flash,gemini-3-flash-preview,gemini-3.1-flash-lite
GEMINI_MAX_RETRIES=4

# GitHub OAuth App (https://github.com/settings/developers)
# Callback URL: <APP_BASE_URL>/auth/github/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Random string used to encrypt stored GitHub tokens. Required in production.
# python -c "import secrets; print(secrets.token_urlsafe(48))"
SESSION_SECRET=

APP_ENV=development
APP_BASE_URL=http://localhost:8000

# Supabase Postgres "Session pooler" connection string. Empty = local SQLite in backend/data/.
DATABASE_URL=

# Allow live API checks against localhost / private networks (keep false in production).
ALLOW_PRIVATE_TARGETS=true
MAX_REPO_FILES=25
JOB_WORKERS=3
